# Copier vers backend/.env sur la VM API (ou deploy/docker/.env)
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api

# SQL Server sur VM BDD (IP PRIVEE OpenStack)
DB_USE_WINDOWS_AUTH=false
DB_HOST=10.0.10.20
DB_PORT=1433
DB_NAME=RealEstateManagement
DB_USER=sa
DB_PASSWORD=ChangeMe_Strong_Password_123!

JWT_SECRET=change-me-long-random-production-secret
JWT_REFRESH_SECRET=change-me-long-random-refresh-secret
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Mobile + tests Postman
CORS_ORIGIN=*

# IA Guide (optionnel en prod)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
