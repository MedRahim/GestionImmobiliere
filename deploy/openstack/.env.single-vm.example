# Copier vers deploy/docker/.env (UNE SEULE VM)

NODE_ENV=production
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api

# SQL Server = conteneur Docker sur la MEME VM
DB_USE_WINDOWS_AUTH=false
DB_HOST=mssql
DB_PORT=1433
DB_NAME=RealEstateManagement
DB_USER=sa
DB_PASSWORD=ChangeMe_Strong_Password_123!

JWT_SECRET=change-me-long-random-production-secret
JWT_REFRESH_SECRET=change-me-long-random-refresh-secret
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

CORS_ORIGIN=*

# Google Sign-In (même Web client ID que mobile/src/config/google.ts)
GOOGLE_CLIENT_ID=

# IA Guide — Groq (https://console.groq.com)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
